# Qdrant Cloud connection (do not commit real credentials)
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION=finlens_tables_metadata_granite_97m_multilingual_r2_v2
QDRANT_ALIAS=finlens_tables_current
QDRANT_TIMEOUT=30
QDRANT_MANIFEST_PATH=intermediate/qdrant_manifest_granite_97m_r2_v2.jsonl
RETRIEVAL_MODE=hybrid
QDRANT_BM25_SCROLL_BATCH=512
QDRANT_BM25_MAX_DOCUMENTS=20000
BM25_K1=1.2
BM25_B=0.75

# Compact multilingual Vietnamese-capable dense retrieval model
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_REVISION=835ad14087e140460703cf0fae09f97d469d65c2
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_LENGTH=512
EMBED_BATCH_SIZE=32

# OpenAI-compatible inference endpoint
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=<open-model-name>
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

# FPT BGE-M3 table reranker
FPT_API_KEY=
FPT_RERANK_URL=https://mkp-api.fptcloud.com/v1/rerank
FPT_RERANK_MODEL=bge-reranker-v2-m3
FPT_RERANK_TIMEOUT=90

E2B_API_KEY=
