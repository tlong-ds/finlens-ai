# Qdrant Cloud connection (do not commit real credentials)
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION=financial_tables
QDRANT_TIMEOUT=30

# OpenAI-compatible inference endpoint
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=<open-model-name>
LLM_TIMEOUT=60
LLM_TEMPERATURE=0
